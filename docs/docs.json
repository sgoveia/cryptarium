            "pages": [
              "detectors/overview",
              "detectors/rule-packs",
              "detectors/adding-a-rule",
              "detectors/fixtures"
            ]
          },
          {
            "group": "Guides",
            "pages": [
              "guides/first-scan",
              "guides/ci-fail-on",
